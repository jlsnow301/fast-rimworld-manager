{
	"fmt": {
		"useTabs": true,
		"indentWidth": 4,
		"singleQuote": true,
		"json.trailingCommas": "jsonc"
	},
	"imports": {
		"@/": "./src/"
	},
	"tasks": {
		"test": "deno test --allow-env=NODE_ENV tests"
	},
	"lint": {
		"rules": {
			"exclude": [
				"no-sloppy-imports",
				"jsx-button-has-type"
			]
		}
	}
}
