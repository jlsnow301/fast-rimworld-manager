{
	"fmt": {
		"useTabs": true,
		"indentWidth": 4,
		"singleQuote": true,
		"json.trailingCommas": "jsonc"
	},
	"imports": {
		"@/": "./src/"
	},
	"tasks": {
		"test": "deno test --allow-env=NODE_ENV tests",
		"format": "deno fmt --check --ignore=.agents --ignore=.claude --ignore=plans --ignore=README.md --ignore=AGENTS.md --ignore=skills-lock.json",
		"lint": "deno lint"
	},
	"lint": {
		"rules": {
			"exclude": [
				"no-sloppy-imports",
				"jsx-button-has-type"
			]
		}
	}
}
