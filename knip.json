{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"tests/**/*_test.ts"
	],
	"project": [
		"src/**/*.{js,jsx,ts,tsx}",
		"src/**/*.css",
		"tests/**/*.{js,jsx,ts,tsx}",
		".storybook/**/*.{js,jsx,ts,tsx}"
	],
	"includeEntryExports": true,
	"treatConfigHintsAsErrors": true,
	"treatTagHintsAsErrors": true,
	"rules": {
		"files": "error",
		"dependencies": "error",
		"devDependencies": "error",
		"optionalPeerDependencies": "error",
		"unlisted": "error",
		"binaries": "error",
		"catalog": "error",
		"catalogReferences": "error",
		"unresolved": "error",
		"exports": "error",
		"types": "error",
		"nsExports": "error",
		"nsTypes": "error",
		"enumMembers": "error",
		"namespaceMembers": "error",
		"duplicates": "error",
		"cycles": "error"
	}
}
